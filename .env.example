# ==============================================================================
# SKILLANCE EXECUTIVE ASSISTANT ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Configuration
# Temukan URL & Anon Key di Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration (Pilihan: openrouter | gemini | openai | custom | rule-based)
# Untuk OpenRouter (9 Router):
# Dapatkan token API di https://openrouter.ai/keys
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-your-openrouter-token-here
AI_MODEL=deepseek/deepseek-chat

# (Opsional) Custom Base URL jika menggunakan router lokal / proxy:
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# App Timezone
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Makassar
